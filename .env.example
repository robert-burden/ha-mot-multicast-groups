HA_URL=https://home.dome.haus
HA_TOKEN=
HA_GROUP_ENTITY=light.dining_room_chandelier

# Matter Server WebSocket on the LAN (not proxied via home.dome.haus).
# After exposing port 5580 on the HAOS Matter Server add-on:
#   MATTER_WS_URL=ws://HOMEASSISTANT_LAN_IP:5580/ws
MATTER_WS_URL=

# Filled in by `join-group` (do not reuse chip-tool sample keys).
MATTER_GROUP_ID=0x0D01
MATTER_GROUP_KEYSET_ID=42
MATTER_GROUP_KEY_HEX=
MATTER_GROUP_NAME=DiningChandelier
